# Copie ce fichier en `.env` (jamais commité) et remplis les valeurs.
# En production, ces variables se règlent dans Render → Environment.

SECRET_KEY=change-me-long-random-string
DEBUG=True
ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local (docker-compose) — laisser vide pour SQLite
DATABASE_URL=postgresql://pickeatgo:pickeatgo@localhost:5432/pickeatgo_db

# Redis local — laisser vide pour le channel layer en mémoire
REDIS_URL=redis://localhost:6379

# Cloudinary (stockage des images) — dashboard Cloudinary → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pickeatgo

# CORS : origine du frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Notifications push (python manage.py generate_vapid_keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=contact@votredomaine.be

# URL publique du frontend (liens des e-mails, lien et QR code de « Mon application »)
FRONTEND_URL=http://localhost:3000

# ── Édition Marque Blanche (instance dédiée à un seul restaurant) ───────────
# APP_MODE=platform (défaut) : place de marché PickEatGo. APP_MODE=single : instance mono-restaurant.
APP_MODE=platform
# Identifiant du restaurant lié, affiché par `python manage.py bootstrap_tenant --name … --email …`
TENANT_RESTAURANT_ID=
# Fuseau de référence des horaires, créneaux et rapports (IANA)
TENANT_TIMEZONE=Europe/Brussels
# Mention « propulsé par PickEatGo » dans le pied de page, les e-mails et les tickets (option de licence)
POWERED_BY_BADGE=true
